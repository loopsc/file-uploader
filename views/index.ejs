<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>
    <meta charset="UTF-8">
    <title>Fileup</title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/navbar.css">
</head>

<body>
    <%- include('./partials/navbar.ejs') %>
        <main>
            <div class="hero">
                <h1>Your files, organised.</h1>
                <p>Upload, manage, and share files from one place.</p>
                <div class="hero-btns">
                    <% if (user) { %>
                        <a href="/folders" class="btn-primary">Go to folders</a>
                        <% } else { %>
                            <button>
                                <a href="/signup" class="btn-primary">Get started</a>

                            </button>
                            <button>
                                <a href="/login" class="btn-secondary">Log in</a>

                            </button>
                            <% } %>
                </div>
            </div>
        </main>
</body>

</html>