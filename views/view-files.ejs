<!-- We receive the following objects from the router: files, folder -->
<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>
    <meta charset="UTF-8">
    <title>
        <%= folder.name %>
    </title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/navbar.css">
</head>

<body>
    <%- include("./partials/navbar.ejs") %>
        <main>
            <header>
                <h1>
                    <%= folder.name%>
                </h1>
                <form action="/folders/<%= folder.id %>/create" method="POST" enctype="multipart/form-data">
                    <input type="file" name="file" required>
                    <button type="submit"><strong>+</strong> Add File</button>
                </form>
            </header>

            <!-- Add headings here -->
            <%- include("./partials/files.ejs", {files: files} ) %>
        </main>
</body>

</html>