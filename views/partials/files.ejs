<!-- Display all files inside a single folder -->
<div class="container">

    <% files.forEach(file=> { %>
        <div class="file">
            <p>
                <%= file.name %>
            </p>
            <p>
                <%= file.size %>
            </p>
            <p>
                <%= file.uploadedAt %>
            </p>
            <a href="" class="button">Download</a>
        </div>
        <% }); %>
</div>