<!-- Display a single folder -->

<div class="container">
    <div class="file">
        <p>
            <%= folder.name %>
        </p>
        <div class="buttons-list">
            <a href="/folders/<%= folder.id %>" class="button">View</a>
            <form action="/folders/<%= folder.id %>/delete" method="POST">
                <button class="danger" type="submit">Delete</button>
            </form>
        </div>

    </div>
</div>