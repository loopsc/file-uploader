<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>
    <meta charset="UTF-8">
    <title>
        Workspace
    </title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/navbar.css">
</head>

<body>
    <%- include("./partials/navbar.ejs") %>
        <main>
            <header class="folder-header">
                <h1>Folders</h1>
                <form action="/folders/create-folder" method="GET" class="form">
                    <button><strong>+</strong> Add New Folder</button>
                </form>
            </header>
            <% folders.forEach(folder=> { %>
                <%- include("./partials/folder.ejs", {folder: folder})%>
                    <% }); %>
        </main>
</body>

</html>